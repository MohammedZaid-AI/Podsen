# Copy to .env for local dev. python-dotenv is installed, so `flask --app app run`
# picks this up automatically.
#
# Only the two Spotify values are required. Ranking runs on a local Ollama by
# default — no API key, and nothing below this line needs changing to get started.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Public origin, no trailing slash. Spotify redirect URI = BASE_URL + /callback
# Local must be http://127.0.0.1:3000 (Spotify rejects "localhost")
BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=change-this
ADMIN_KEY=pick-a-long-random-string
DATA_DIR=./data
PORT=3000

# --- Ranking backend: "ollama" (default, local, free) or "claude" ---
# Leave unset for ollama. Everything below is optional.
# RANK_BACKEND=ollama

# Ollama. Defaults shown; the app sets num_ctx per request, so there is NO need to
# set OLLAMA_CONTEXT_LENGTH on the Ollama server any more.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b          # 26b needs ~20GB VRAM/RAM; e4b runs on a laptop
# OLLAMA_NUM_CTX=8192              # raising this costs KV-cache RAM
# OLLAMA_THINK=false               # true = slower (~2.8x) reasoning mode
# OLLAMA_TIMEOUT_MS=300000

# Claude — only needed if you set RANK_BACKEND=claude. ~$0.02/run.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
