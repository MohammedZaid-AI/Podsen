# Copy to .env for local dev. python-dotenv is installed, so `flask run` picks this
# up automatically; `python app.py` does not — use `flask --app app run` locally.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Public origin, no trailing slash. Spotify redirect URI = BASE_URL + /callback
# Local must be http://127.0.0.1:3000 (Spotify rejects "localhost")
BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=change-this
ADMIN_KEY=pick-a-long-random-string
DATA_DIR=./data
PORT=3000

# --- Ranking backend: "claude" (default) or "ollama" ---
RANK_BACKEND=claude

# Required when RANK_BACKEND=claude. ~$0.02/run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Only used when RANK_BACKEND=ollama. Free, but see the caveats in the README:
# weaker picks, and "localhost" means the machine running Podsen — on a hosted
# deploy that is the container, not your laptop.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:26b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT_MS=180000

# NOTE for RANK_BACKEND=ollama: also set OLLAMA_CONTEXT_LENGTH=16384 on the *Ollama
# server* (not here). Ollama defaults to a 4096-token context and the /v1 endpoint
# ignores per-request num_ctx, which truncates the ranking answer before it emits JSON.
