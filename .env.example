# Copy to .env for local dev. python-dotenv is installed, so `flask --app app run`
# picks this up automatically.
#
# Nothing here is needed just to run the app: accounts, show search (Apple's free
# iTunes API) and picks (public RSS) need no keys. Set SESSION_SECRET and ADMIN_KEY
# before anyone else uses it; set GROQ_API_KEY to run the v1_llm row of the report.

# Signs the login cookie. Use a long random value; changing it logs everyone out.
SESSION_SECRET=change-this
# Unlocks /admin, and /label from any address other than this machine (?key=...)
ADMIN_KEY=pick-a-long-random-string
DATA_DIR=./data
PORT=3000

# --- Ranking backend (used by the v1_llm evaluation baseline): "groq" (default) or "claude"
# RANK_BACKEND=groq

# Groq. Get a key at https://console.groq.com/keys. Defaults shown.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_S=300

# Claude — only needed if you set RANK_BACKEND=claude.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
