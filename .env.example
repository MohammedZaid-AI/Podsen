# Copy to .env for local dev. python-dotenv is installed, so `flask --app app run`
# picks this up automatically.
#
# Required: the two Spotify values and GROQ_API_KEY. Ranking calls the hosted Groq
# API by default; everything else below has a working default.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Public origin, no trailing slash. Spotify redirect URI = BASE_URL + /callback
# Local must be http://127.0.0.1:3000 (Spotify rejects "localhost")
BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=change-this
# Unlocks /admin, and /label from any address other than this machine (?key=...)
ADMIN_KEY=pick-a-long-random-string
DATA_DIR=./data
PORT=3000

# --- Ranking backend: "groq" (default) or "claude" ---
# RANK_BACKEND=groq

# Groq. Get a key at https://console.groq.com/keys. Defaults shown.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_S=300

# Claude — only needed if you set RANK_BACKEND=claude. ~$0.02/run.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: a logo image uploaded as the cover of each Podsen playlist. Needs Pillow
# (pip install Pillow). Best effort: if the upload fails, the playlist is still made.
# PODSEN_LOGO_PATH=
