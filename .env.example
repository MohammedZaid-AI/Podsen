# Copy to .env for local dev. python-dotenv is installed, so `flask --app app run`
# picks this up automatically. .env is gitignored: never commit real values.

# Signs the login cookie. Use a long random value (32+ characters); changing it logs
# everyone out. In production the app refuses to start with this placeholder.
SESSION_SECRET=change-this
# Unlocks /admin, and /label from any address other than this machine (?key=...)
ADMIN_KEY=pick-a-long-random-string
DATA_DIR=./data
PORT=3000

# --- Supabase (Google sign-in + database) --------------------------------------------
# Dashboard -> Project Settings -> API. The project URL, no trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key. Used only to finish Google sign-in (the PKCE code exchange).
# Safe-ish by design, but Row Level Security (v2/supabase_setup.sql) is what keeps it
# from reading our tables.
SUPABASE_ANON_KEY=
# The "service_role" key. SECRET: full admin access to the project. Used server side
# only, to delete a user's sign-in record when they delete their account. It must
# never appear in a page, a URL, a log or git.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Connect -> "Session pooler" URI (host *.pooler.supabase.com, port 5432),
# with your database password filled in. On Render this MUST be the Session pooler:
# the direct db.<ref>.supabase.co host is IPv6-only and doesn't work from Render.
# Locally either works. Leave empty to use a local SQLite file at DATA_DIR/podsen_v2.db.
# In production (FLASK_ENV=production) the app refuses to start without it.
DATABASE_URL=

# --- Ranking backend (used by the v1_llm evaluation baseline): "groq" (default) or "claude"
# RANK_BACKEND=groq

# Groq. Get a key at https://console.groq.com/keys. Defaults shown.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_S=300

# Claude — only needed if you set RANK_BACKEND=claude.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
